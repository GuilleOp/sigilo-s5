{
  "name": "sigilo-s5",
  "version": "1.1.0",
  "private": true,
  "description": "Capa de anonimato verificable para el Sistema de denuncias publicas (S5) de la Plataforma Digital Nacional.",
  "license": "CC-BY-NC-4.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/contracts",
    "packages/core",
    "packages/huella",
    "packages/red",
    "packages/anonimato",
    "packages/contexto-pdn",
    "packages/auditor",
    "packages/corroboracion",
    "apps/server",
    "apps/web",
    "apps/enrutador",
    "apps/corroboracion",
    "tools/validador",
    "tools/sigilo"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:test": "python3 -m unittest discover -s datos/proceso -t datos/proceso",
    "pretest:e2e": "npm run build -w @sigilo/web",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run data:test",
    "dev:server": "npm run dev -w @sigilo/server",
    "dev:web": "npm run dev -w @sigilo/web",
    "dev:enrutador": "npm run dev -w @sigilo/enrutador",
    "hooks:install": "node scripts/install-hooks.mjs",
    "keys:generate": "node scripts/generate-keys.ts",
    "accounts:generate": "node scripts/generate-accounts.ts",
    "ledger:anchor": "node scripts/ledger-anchor.ts",
    "demo:reset": "node scripts/demo-reset.ts",
    "standard:build": "node scripts/build-standard.ts",
    "validate": "node tools/validador/src/cli.ts",
    "validate:pdn": "node tools/validador/src/pdn/cli.ts",
    "sigilo": "node tools/sigilo/src/cli.ts",
    "red:demo": "node scripts/red-demo.ts",
    "demo:seed": "node scripts/demo-seed.ts",
    "demo:todo": "node scripts/demo-todo.ts",
    "demo:apagar": "node scripts/demo-apagar.ts",
    "auditor:eval": "node packages/auditor/src/eval/cli.ts",
    "dev:evaluador": "npm run dev:evaluador -w @sigilo/corroboracion-servicio",
    "dev:indice": "npm run dev:indice -w @sigilo/corroboracion-servicio"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "swagger-ui-dist": "5.34.1",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "scarfSettings": {
    "enabled": false
  }
}
